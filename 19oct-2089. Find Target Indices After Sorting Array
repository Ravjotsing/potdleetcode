brute - nlogn
class Solution {
public:
    vector<int> targetIndices(vector<int>& nums, int target) {
        int n = nums.size();
        sort(nums.begin(), nums.end());
        vector<int> res;
        for (int i = 0; i < n; ++i) {
            if (nums[i] == target) {
                res.push_back(i);
            }
        }
        return res;
    }
};

Better - O(n)
class Solution {
public:
    vector<int> targetIndices(vector<int>& nums, int target) {
        int cnt1=0;
        int cnt2=0;
        int n = nums.size();
        for(auto num:nums){
            if(num<target){
                cnt1++;
            }else if(num == target){
                cnt2++;
            }
        }
        vector<int>res;
        for(int i = cnt1;i<cnt1+cnt2;i++){
            res.push_back(i);
        }
        return res;
    }
};
